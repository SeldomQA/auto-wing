# auto-wing environment configuration template
# Copy this file to `.env` and fill in your own API keys.
# NEVER commit `.env` to version control (already ignored by .gitignore).

# ------------------------------------------------------------------
# Model provider: openai | qwen | deepseek | doubao | gemini
# ------------------------------------------------------------------
AUTOWING_MODEL_PROVIDER=deepseek

# ------------------------------------------------------------------
# Vision mode: true | false (default: false)
# When enabled, a screenshot is attached to each AI call so that
# vision-capable models can ground their answers visually.
# Requires a vision-capable model (e.g. gpt-4o, qwen-vl-max,
# gemini-2.0-flash, doubao vision endpoint). Falls back to text
# mode automatically if the model doesn't support images.
# ------------------------------------------------------------------
AUTOWING_VISION=false

# ------------------------------------------------------------------
# Intelligent cache directory (default: .auto-wing/cache)
# One shared IntelligentCacheManager per directory is reused across
# all fixtures in the same process, so cache hits work across cases.
# ------------------------------------------------------------------
#AUTOWING_CACHE_DIR=.auto-wing/cache

# ------------------------------------------------------------------
# ai_action retry/re-plan budget (default: 2)
# When the LLM returns invalid JSON or an action fails, auto-wing
# re-asks the LLM with the error context, up to this many retries.
# ------------------------------------------------------------------
#AUTOWING_MAX_RETRIES=2

# ------------------------------------------------------------------
# DeepSeek: https://platform.deepseek.com/
# ------------------------------------------------------------------
DEEPSEEK_API_KEY=sk-your-deepseek-api-key
#DEEPSEEK_BASE_URL=https://api.deepseek.com
#DEEPSEEK_MODEL_NAME=deepseek-chat

# ------------------------------------------------------------------
# Qwen (Aliyun Bailian): https://bailian.console.aliyun.com/
# ------------------------------------------------------------------
#DASHSCOPE_API_KEY=sk-your-dashscope-api-key
# Model name is read from MIDSCENE_MODEL_NAME (historical variable name)
#MIDSCENE_MODEL_NAME=qwen3-max

# ------------------------------------------------------------------
# OpenAI: https://platform.openai.com/
# ------------------------------------------------------------------
#OPENAI_API_KEY=sk-your-openai-api-key
#OPENAI_BASE_URL=https://api.openai.com/v1
#MIDSCENE_MODEL_NAME=gpt-4o-2024-08-06

# ------------------------------------------------------------------
# Doubao (Volcengine Ark): https://console.volcengine.com/
# ------------------------------------------------------------------
#ARK_API_KEY=your-ark-api-key
#DOUBAO_BASE_URL=https://ark.cn-beijing.volces.com/api/v3
#DOUBAO_MODEL_NAME=ep-xxxxxxxx-xxxxx

# ------------------------------------------------------------------
# Gemini (Google AI Studio): https://aistudio.google.com/
# ------------------------------------------------------------------
#GOOGLE_API_KEY=your-google-api-key
#MIDSCENE_MODEL_NAME=gemini-2.0-flash
