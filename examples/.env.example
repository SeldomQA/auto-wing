# auto-wing environment configuration template
# Copy this file to `.env` and fill in your own API keys.
# NEVER commit `.env` to version control (already ignored by .gitignore).

# ------------------------------------------------------------------
# Model provider: openai | deepseek | qwen | doubao | gemini
# ------------------------------------------------------------------
AUTOWING_MODEL_PROVIDER=qwen

# ------------------------------------------------------------------
# DeepSeek: https://platform.deepseek.com/
# ------------------------------------------------------------------
#DEEPSEEK_API_KEY=sk-your-deepseek-api-key
# Optional model name (default: deepseek-chat)
#DEEPSEEK_MODEL_NAME=deepseek-chat
# Optional API endpoint (default: https://api.deepseek.com)
#DEEPSEEK_BASE_URL=https://api.deepseek.com

# ------------------------------------------------------------------
# Qwen (Aliyun Bailian): https://bailian.console.aliyun.com/
# ------------------------------------------------------------------
DASHSCOPE_API_KEY=sk-your-dashscope-api-key
# Optional model name (default: qwen3-max; use a VL model, e.g.
# qwen3-vl-plus, when AUTOWING_VISION=true)
#QWEN_MODEL_NAME=qwen3-max
# Optional API endpoint (default: Aliyun OpenAI-compatible endpoint)
#QWEN_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1

# ------------------------------------------------------------------
# OpenAI: https://platform.openai.com/
# ------------------------------------------------------------------
#OPENAI_API_KEY=sk-your-openai-api-key
# Optional model name (default: gpt-4o-2024-08-06)
#OPENAI_MODEL_NAME=gpt-4o-2024-08-06
# Optional API endpoint (default: https://api.openai.com/v1)
#OPENAI_BASE_URL=https://api.openai.com/v1

# ------------------------------------------------------------------
# Doubao (Volcengine Ark): https://console.volcengine.com/
# ------------------------------------------------------------------
#ARK_API_KEY=your-ark-api-key
# Required: the inference endpoint name created on the Ark console
#DOUBAO_MODEL_NAME=ep-xxxxxxxx-xxxxx
# Optional API endpoint (default: Ark Beijing endpoint)
#DOUBAO_BASE_URL=https://ark.cn-beijing.volces.com/api/v3

# ------------------------------------------------------------------
# Gemini (Google AI Studio): https://aistudio.google.com/
# ------------------------------------------------------------------
#GOOGLE_API_KEY=your-google-api-key
# Optional model name (default: gemini-2.0-flash)
#GEMINI_MODEL_NAME=gemini-2.0-flash

# ------------------------------------------------------------------
# auto-wing runtime options (all optional)
# ------------------------------------------------------------------
# Vision mode: attach a screenshot to each AI call so vision-capable
# models can ground their answers visually. Falls back to text mode
# automatically if the model doesn't support images.
#AUTOWING_VISION=false
# Intelligent cache directory (default: .auto-wing/cache). One shared
# IntelligentCacheManager per directory is reused across all fixtures.
#AUTOWING_CACHE_DIR=.auto-wing/cache
# ai_action retry/re-plan budget: when the LLM returns invalid JSON or
# an action fails, auto-wing re-asks the LLM with the error context.
#AUTOWING_MAX_RETRIES=2
# Per-element operation timeout in seconds (default: 30)
#AUTOWING_ACTION_TIMEOUT=30
# Print full prompts and raw LLM responses (default: false)
#AUTOWING_DEBUG=false
# Directory for failure screenshots (default: .auto-wing/screenshots)
#AUTOWING_SCREENSHOT_DIR=.auto-wing/screenshots
